# Google Cloud project (Firestore Native mode must be enabled)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# Prefer a GCP attached service identity in production. For local testing only,
# store a newly rotated service-account JSON securely in this server-side variable.
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/Master-Mind-Portal/secrets/google-service-account.json
# Alternative only: GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Drive folder shared with the service account (Editor access)
GOOGLE_DRIVE_FOLDER_ID=
# Session + initial admin (never commit real values)
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_MOBILE=1234567890
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_AT_LEAST_12_CHARS
ADMIN_NAME=Master Mind Administrator
ADMIN_EMAIL=admin@example.invalid
COOKIE_SECURE=true
CORS_ORIGINS=
