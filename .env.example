# Required for authentication in production
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_MOBILE=1234567890
ADMIN_PASSWORD=replace-with-at-least-14-random-characters
ADMIN_NAME=Portal Administrator

# Account records (signup/login) are stored in MongoDB when configured.
# Set MONGO_AUTH_REQUIRED=true in production only after MONGODB_URI is set.
# Obtain the URI from MongoDB Atlas; never commit the real value.
# MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=mastermind_portal
MONGO_AUTH_REQUIRED=false

# Optional
# DATABASE_URL=sqlite:///./mastermind.db
# UPLOAD_DIR=mastermind_storage
# ALLOWED_ORIGINS=https://your-domain.example
